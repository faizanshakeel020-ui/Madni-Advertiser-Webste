generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Shop categories (Etsy-style browsable categories) ----
model Category {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  description   String?
  image         String?
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  products      Product[]
  subcategories Subcategory[]
}

// ---- Shop subcategories (nested under a category) ----
model Subcategory {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  sortOrder  Int       @default(0)
  products   Product[]
}

// ---- Products: BUY_NOW (cart enabled), CUSTOM_ORDER (quote only), BOTH (cart + quote) ----
enum ProductType {
  BUY_NOW
  CUSTOM_ORDER
  BOTH
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  price       Int? // null => "Custom Pricing" / quote based
  oldPrice    Int?
  type        ProductType @default(CUSTOM_ORDER)
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id])
  subcategoryId  String?
  subcategory    Subcategory? @relation(fields: [subcategoryId], references: [id])
  images         String       @default("[]") // JSON array of image paths
  specs          String? // JSON array of {label, value}
  options        String? // JSON array of {label, values: []} for customization
  badge          String? // e.g. Best Seller, New
  stock          Int          @default(10)
  featured       Boolean      @default(false)
  popularity     Int          @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ---- Buy Now orders ----
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerName  String
  phone         String
  email         String?
  address       String
  city          String
  items         String // JSON array of {id, slug, name, image, price, qty}
  subtotal      Int
  paymentMethod String // COD | BANK_TRANSFER
  status        OrderStatus @default(PENDING)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ---- Quote requests for custom/service work ----
enum QuoteStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
}

model QuoteRequest {
  id             String      @id @default(cuid())
  reference      String      @unique
  name           String
  phone          String
  email          String?
  service        String
  productName    String?
  details        String
  city           String
  referenceImage String? // path served via /api/files/...
  status         QuoteStatus @default(NEW)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// ---- Admin login (separate from guest checkout) ----
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  settings     Json     @default("{}")
  createdAt    DateTime @default(now())
}

// ---- Clients shown in the homepage "Our Clients" section ----
model Client {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique // URL: /casestudy/portfolio/<slug>
  logo      String // path served from /images or /api/files
  industry  String? // e.g. Hospitality, Healthcare
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  projects  ClientProject[]
}

// ---- Projects delivered for a client (shown on logo click) ----
model ClientProject {
  id          String   @id @default(cuid())
  title       String
  description String
  images      String   @default("[]") // JSON array of image paths — first is the main one
  year        Int?
  sortOrder   Int      @default(0)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

// ---- Service pillars (Services page, mega menu, home, quote form) ----
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  shortName   String   @default("")
  tagline     String   @default("")
  description String   @default("")
  hero        String   @default("") // hero image path
  icon        String   @default("building")
  subServices String   @default("[]") // JSON array of {name, description, image}
  projectTags String   @default("[]") // JSON array of portfolio category names
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Portfolio gallery items (Portfolio page, home Recent Projects) ----
model PortfolioItem {
  id          String   @id @default(cuid())
  title       String
  client      String   @default("")
  city        String   @default("")
  category    String   @default("Other")
  image       String   @default("")
  description String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
